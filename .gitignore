# 依赖
node_modules/

# 构建产物
out/
dist/

# CEF 内核（本地缓存，体积大，不入库；由 scripts/fetch-cef.mjs 自动下载）
.cef-cache/
third_party/cef/

# 原生构建目录
build-native/
native/**/CMakeFiles/
native/**/CMakeCache.txt
*.pdb
*.ilk
*.obj
# release 目录默认忽略，但保留安装包供用户直接下载
release/*
!release/*.exe
!release/README.md

# 日志
*.log
npm-debug.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# 本地敏感数据（API key 加密存储，勿提交）
*.local.json

# 临时验证产物
.tmp-*


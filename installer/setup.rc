// TiBrowser 安装器的资源：图标与版本信息
// 图标复用主程序的那一份（由根目录 ico.png 生成）
#include <windows.h>

IDI_TIBSETUP ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,1,260918
  PRODUCTVERSION  1,0,1,260918
  FILEFLAGSMASK   0x3fL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "turtlelnc"
      VALUE "FileDescription",  "TiBrowser 安装程序"
      VALUE "FileVersion",      "1.0.1-rc2 (build 260918)"
      VALUE "InternalName",     "TiBrowserSetup"
      VALUE "LegalCopyright",   "Copyright (C) 2026 TiBrowser. GPL-3.0-only"
      VALUE "OriginalFilename", "TiBrowserSetup.exe"
      VALUE "ProductName",      "TiBrowser"
      VALUE "ProductVersion",   "1.0.1-rc2 (build 260918)"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
